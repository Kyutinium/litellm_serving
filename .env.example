# Copy to .env (gitignored). Every key the running system reads is listed here,
# with WHO reads it — that is the part that used to be hard to see.

# ── LiteLLM ───────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=change-me            # LiteLLM proxy bearer key (was hard-coded sk-1234)
LITELLM_PORT=3999
# strip_thinking.py (LiteLLM worker hook): default | none | text | think_tag
THINK_OUTPUT_MODE=none

# ── Sanitizer (Anthropic /v1/messages in front of LiteLLM; Claude Code CLI path) ─
SANITIZER_PORT=3996
SANITIZER_USE_OPENAI_BRIDGE=true        # translate in-process instead of LiteLLM's Anthropic adapter
SANITIZER_THINK_OUTPUT_MODE=default     # sanitizer/output_transform.py; falls back to THINK_OUTPUT_MODE
SANITIZER_REQUEST_TIMEOUT=0             # seconds; 0 = none (streams can be long)
SANITIZER_TLS_VERIFY=true               # true | false | /path/to/ca-bundle
# Per-model effort levels each upstream accepts. Generated: run
# `python3 scripts/render.py` and copy the line from .env.rendered.
# SANITIZER_EFFORT_VOCABULARY={"qwen3.6-27b":"low,medium,xhigh","Qwen3.6-27B":"low,medium,xhigh"}

# ── Registry ──────────────────────────────────────────────────────────────────
# A deployment keeps its own model registry out of git:
# MODELS_FILE=models.local.yaml
